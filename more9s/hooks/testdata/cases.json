[
  {"name": "em dash in prose", "path": "a.md", "text": "one — two", "want": ["em dash"]},
  {"name": "em dash in a code comment", "path": "a.go", "text": "x := 1 // one — two", "want": ["em dash"]},
  {"name": "em dash in a code string", "path": "a.go", "text": "x := \"one — two\"", "want": []},
  {"name": "todo with no issue", "path": "a.go", "text": "// TODO fix later", "want": ["TODO"]},
  {"name": "todo beside an unrelated number", "path": "a.go", "text": "// TODO fix later, see color #123", "want": ["TODO"]},
  {"name": "todo with an issue id", "path": "a.go", "text": "// TODO(#123) fix later", "want": []},
  {"name": "todo with a tracker key", "path": "a.py", "text": "# TODO(CORE-42) fix later", "want": []},
  {"name": "todo with a lint rule", "path": "a.py", "text": "# TODO(lint:no-raw-exec) frozen", "want": []},
  {"name": "todo with a url", "path": "a.py", "text": "# TODO fix, https://example.com/issues/1", "want": []},
  {"name": "todo outside a comment", "path": "a.py", "text": "TODO = 1", "want": []},
  {"name": "todo in prose", "path": "a.md", "text": "A TODO links an issue.", "want": []},
  {"name": "bare nolint", "path": "a.go", "text": "x() //nolint", "want": ["names no specific check"]},
  {"name": "nolint with no reason", "path": "a.go", "text": "x() //nolint:errcheck", "want": ["no reason"]},
  {"name": "nolint with a reason", "path": "a.go", "text": "x() //nolint:errcheck // close error is not actionable", "want": []},
  {"name": "bare noqa", "path": "a.py", "text": "import x  # noqa", "want": ["names no specific check"]},
  {"name": "noqa with no reason", "path": "a.py", "text": "import x  # noqa: F401", "want": ["no reason"]},
  {"name": "type ignore with a reason", "path": "a.py", "text": "x = f()  # type: ignore[arg-type]  # stub is wrong", "want": []},
  {"name": "eslint with no rule", "path": "a.ts", "text": "// eslint-disable-next-line", "want": ["names no specific check"]},
  {"name": "eslint with a reason", "path": "a.ts", "text": "// eslint-disable-next-line no-console -- this is the cli output", "want": []},
  {"name": "ts expect error with no reason", "path": "a.ts", "text": "// @ts-expect-error", "want": ["no reason"]},
  {"name": "rust allow with no reason", "path": "a.rs", "text": "#[allow(dead_code)]", "want": ["no reason"]},
  {"name": "rust allow with a reason", "path": "a.rs", "text": "#[allow(dead_code)] // used by the derive macro", "want": []},
  {"name": "data file is skipped", "path": "a.json", "text": "\"// TODO fix\"", "want": []},
  {"name": "new snapshot file", "path": "t/__snapshots__/a.txt", "text": "", "created": true, "want": ["snapshot"]},
  {"name": "new golden file", "path": "t/out.golden", "text": "", "created": true, "want": ["snapshot"]},
  {"name": "new golden file in a characterization directory", "path": "t/characterization/out.golden", "text": "", "created": true, "want": []},
  {"name": "new snapshot file beside a characterization-named file", "path": "t/characterization_out.golden", "text": "", "created": true, "want": ["snapshot"]},
  {"name": "new vague file name", "path": "pkg/utils.py", "text": "", "created": true, "want": ["says nothing"]},
  {"name": "existing vague file name", "path": "pkg/utils.py", "text": "x = 1", "want": []}
]
